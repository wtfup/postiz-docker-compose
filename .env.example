# WTF Postiz deployment — secrets template
# Copy to .env on the server, fill values, NEVER commit .env.
# Generate with: openssl rand -base64 48 (or -hex 32)

# --- Core secrets ---
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_24

# --- AI: Azure OpenAI (WTF prod default) ---
AZURE_OPENAI_ENDPOINT=https://vishal-0284-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=model-router
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2.5-sunburst
# Fallback / non-Azure path (unused when Azure vars are set)
OPENAI_API_KEY=

# --- Meta / Instagram (see INSTAGRAM_STANDALONE_setup.md in postiz-app repo) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Registration: set true AFTER the admin account is created ---
DISABLE_REGISTRATION=false
